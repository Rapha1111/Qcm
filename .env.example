# URL de base de ton Moodle, sans slash final
MOODLE_URL=https://moodle.exemple.fr
# Service web utilisé pour obtenir le token (par défaut : application mobile Moodle)
MOODLE_SERVICE=moodle_mobile_app

# Bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Clé de chiffrement des mots de passe stockés. Génère-la avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Fréquence de vérification en minutes
POLL_MINUTES=10
